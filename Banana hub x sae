    Title.Text = "BANANA HUB"
    Title.TextColor3 = Color3.fromRGB(255, 220, 30)
    Title.TextSize = 25
    Title.Font = Enum.Font.FredokaOne
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Frame

    -- Dòng Trạng Thái
    local Status = Instance.new("TextLabel")
