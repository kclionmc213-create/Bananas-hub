local function BuildBananaUI()
    local Gui = Instance.new("ScreenGui")
    Gui.Name = "BananaHub_UI"
    Gui.ResetOnSpawn = false

    local player = Services.Players.LocalPlayer or Services.Players.PlayerAdded:Wait()
    
    -- Gắn Gui an toàn
    local setParentSuccess = pcall(function()
        Gui.Parent = Services.Core
    end)
    if not setParentSuccess or not Gui.Parent then
        Gui.Parent = player:WaitForChild("PlayerGui")
    end

    -- Khung Menu Chính (480x140px)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 480, 0, 140)
    Frame.Position = UDim2.new(0.5, -240, 1, 50)
    Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 15)
    Frame.BorderSizePixel = 0
    Frame.ClipsDescendants = true
    Frame.Parent = Gui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 16)
    UICorner.Parent = Frame

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(255, 215, 0)
    UIStroke.Thickness = 3
    UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    UIStroke.Parent = Frame

    -- Icon Chuối
    local Icon = Instance.new("TextLabel")
