    -- Nút Chuyển Ngôn Ngữ
    local LangToggleBtn = Instance.new("TextButton")
    LangToggleBtn.Size = UDim2.new(0, 200, 0, 45)
    LangToggleBtn.Position = UDim2.new(0.5, -100, 0, 60)
    LangToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
    LangToggleBtn.Text = "🇻🇳 Tiếng Việt"
    LangToggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    LangToggleBtn.TextSize = 16
    LangToggleBtn.Font = Enum.Font.GothamBold
    LangToggleBtn.ZIndex = 6
    LangToggleBtn.Parent = SettingPanel

    local LangCorner = Instance.new("UICorner")
    LangCorner.CornerRadius = UDim.new(0, 10)
    LangCorner.Parent = LangToggleBtn

    -- LOGIC BẬT TẮT SETTING
    local isSettingOpen = false
    local currentStatusKey = "CheckingGame"
    local currentExtraText = ""

    local function ToggleSetting()
        isSettingOpen = not isSettingOpen
        Services.Tween:Create(SettingPanel, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = isSettingOpen and UDim2.new(0, 0, 0, 0) or UDim2.new(0, 0, 1, 0)
        }):Play()
    end

    SettingBtn.MouseButton1Click:Connect(ToggleSetting)
    CloseSettingBtn.MouseButton1Click:Connect(ToggleSetting)

    -- SỰ KIỆN ĐỔI NGÔN NGỮ
    LangToggleBtn.MouseButton1Click:Connect(function()
        if currentLang == "VI" then
            currentLang = "EN"
            LangToggleBtn.Text = "🇬🇧 English"
        else
            currentLang = "VI"
            LangToggleBtn.Text = "🇻🇳 Tiếng Việt"
        end

        SettingTitle.Text = LANGUAGES[currentLang].SettingTitle
        local msg = LANGUAGES[currentLang][currentStatusKey] or currentStatusKey
        Status.Text = currentExtraText ~= "" and (msg .. " (" .. currentExtraText .. ")") or msg
    end)

    -- TRƯỢT MENU LÊN
    Services.Tween:Create(Frame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -240, 1, -170)
    }):Play()

    -- HÀM CẬP NHẬT TRẠNG THÁI
    local function UpdateProgress(key, progressPercent, extraInfo)
        currentStatusKey = key
        currentExtraText = extraInfo or ""
        
        local msg = LANGUAGES[currentLang][key] or key
        Status.Text = currentExtraText ~= "" and (msg .. " (" .. currentExtraText .. ")") or msg

        Services.Tween:Create(BarFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(progressPercent, 0, 1, 0)
        }):Play()
    end

    -- HÀM ĐÓNG MENU
    local function CloseUI()
        Services.Tween:Create(Frame, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -240, 1, 50)
        }):Play()
        task.wait(0.5)
        Gui:Destroy()
    end

    return UpdateProgress, CloseUI
end

-- 5. THỰC THI CHÍNH
local setUIProgress, destroyUI = BuildBananaUI()

local currentGId = game.GameId
while currentGId == 0 and game.PlaceId == 0 do
    task.wait()
    currentGId = game.GameId
end

setUIProgress("CheckingGame", 0.3)
task.wait(0.3)

local scriptUrl = GAME_MAP.ByGame[currentGId] or GAME_MAP.ByPlace[game.PlaceId]

if not scriptUrl then
    setUIProgress("NotSupported", 1)
    task.wait(2.5)
    destroyUI()
    return
end

local isSuccess = false

for attempt = 1, 3 do
    setUIProgress("Downloading", 0.3 + (attempt * 0.2), "Lần " .. attempt .. "/3")
    
    local ok, sourceCode = pcall(game.HttpGet, game, scriptUrl)
    if ok and type(sourceCode) == "string" and sourceCode ~= "" then
        local executable = loadstring(sourceCode)
        if executable then
            setUIProgress("Success", 1)
            task.wait(0.8)
            destroyUI()
            
            executable()
            isSuccess = true
            return
        end
    end
    task.wait(0.5)
end

if not isSuccess then
    setUIProgress("Failed", 1)
    task.wait(2.5)
    destroyUI()
end
